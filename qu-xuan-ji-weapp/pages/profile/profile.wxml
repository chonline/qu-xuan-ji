<!-- 个人中心页面 - 优化版 -->
<view class="profile-container">
  <view class="header">
    <image src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <text class="nickname">{{userInfo.nickname}}</text>
    <view class="vip-tag" wx:if="{{isVip}}">VIP</view>
  </view>
  <view class="menu-list">
    <view class="menu-item" bindtap="goToFortuneHistory">占卜历史</view>
    <view class="menu-item" bindtap="goToFavorites">我的收藏</view>
    <view class="menu-item" bindtap="showVipCenter">会员中心</view>
    <view class="menu-item" bindtap="editProfile">编辑档案</view>
  </view>
</view>